---
import PageLayout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { CldImage } from 'astro-cloudinary';
import { Masonry } from 'astro-masonry';

const meta = {
  description: "Latest work",
  title: "Portfolio",
};

const sketches = await getCollection("sketches");
const fanart = await getCollection("fanart");
const oc = await getCollection("oc");
---

<PageLayout meta={meta}>
  <h1 class="title mb-12">Portfolio</h1>
  <div class="prose prose-sm prose-cactus max-w-none">
    <p>
      Under construction...
    </p>
    <Masonry
      breakpointCols={{
        default: 3,
        1100: 1
      }}
    >
      {sketches.map((img) => (
              <CldImage
                src={img.data.public_id}
                width={img.data.width / 4}
                height={img.data.height / 4}
                alt=""
              />
    )) }
      {oc.map((img) => (
              <CldImage
                src={img.data.public_id}
                width={img.data.width / 4}
                height={img.data.height / 4}
                alt=""
              />
    )) }

      {fanart.map((img) => (
              <CldImage
                src={img.data.public_id}
                width={img.data.width / 4}
                height={img.data.height / 4}
                alt=""
              />
    )) }
    </Masonry>
  </div>
</PageLayout>
