---
import PageLayout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { CldImage } from "astro-cloudinary";
import { getCldImageUrl } from "astro-cloudinary/helpers";
import { Masonry } from "astro-masonry";
import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const meta = {
	description: "Latest work",
	title: "Portfolio",
};

const sketches = await getCollection("sketches");
const fanart = await getCollection("fanart");
const oc = await getCollection("oc");
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Portfolio</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>Under construction...</p>
		<Masonry
			breakpointCols={{
				default: 3,
				1100: 1,
			}}
		>
			{
				[...sketches, ...oc, ...fanart].map((img) => (
					<a
						style={`--width: ${img.data.width}; --height: ${img.data.height};`}
						href={getCldImageUrl({ src: img.data.public_id })}
						target="_blank"
						data-fancybox="gallery"
					>
						<CldImage
							src={img.data.public_id}
							width={img.data.width / 4}
							height={img.data.height / 4}
							alt=""
						/>
					</a>
				))
			}
		</Masonry>
	</div>
</PageLayout>

<script>
	import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

	Fancybox.bind("[data-fancybox]", {
		theme: "auto",
		mainStyle: {
			"--f-button-width": "44px",
			"--f-button-height": "44px",
			"--f-button-border-radius": "50%",
			"--f-toolbar-padding": "16px",
		},
		Carousel: {
			Arrows: true,
			Toolbar: {
				display: {
					left: [],
					middle: [],
					right: ["close"],
				},
			},
			transition: "slide",
		},
	});
</script>
