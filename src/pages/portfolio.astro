---
import PageLayout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { CldImage } from 'astro-cloudinary';

const meta = {
  description: "Latest work",
  title: "Portfolio",
};

const imgs = await getCollection("image");
---

<PageLayout meta={meta}>
  <h1 class="title mb-12">Portfolio</h1>
  <div class="prose prose-sm prose-cactus max-w-none">
    <p>
      Under construction...
    </p>
    <ul class="space-y-6" role="list">
      {imgs.map((img) => (
            <li>
              <CldImage
                src={img.data.public_id}
                width={img.data.width / 4}
                height={img.data.height / 4}
                alt=""
              />
              
            </li> 
)) }
    </ul>
  </div>
</PageLayout>
